<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.4"/>
  <template class="UnityLockUserPage" parent="AdwBin">
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <property name="child">
      <object class="GtkOverlay">
        <property name="child">
          <object class="GtkPicture" id="wallpaper">
            <property name="content-fit">cover</property>
          </object>
        </property>
        <child type="overlay">
          <object class="GtkButton" id="back">
            <property name="halign">start</property>
            <property name="valign">start</property>
            <property name="margin-top">12</property>
            <property name="margin-start">12</property>
            <property name="icon-name">go-previous-symbolic</property>
            <property name="tooltip-text" translatable="yes">Back</property>
            <property name="action-name">lock.back</property>
            <style>
              <class name="osd"/>
            </style>
          </object>
        </child>
        <child type="overlay">
      <object class="AdwBreakpointBin">
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        <property name="width-request">200</property>
        <property name="height-request">300</property>
        <child>
          <object class="AdwBreakpoint">
            <condition>max-width: 600sp</condition>
            <setter object="avatar" property="size">128</setter>
          </object>
        </child>
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <property name="width-request">360</property>
            <property name="spacing">24</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <style>
              <class name="unity-lock-prompt"/>
            </style>
            <child>
              <object class="AdwAvatar" id="avatar">
                <property name="size">192</property>
                <property name="show-initials">true</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="name_label">
                <property name="halign">center</property>
                <property name="ellipsize">end</property>
                <style>
                  <class name="title-2"/>
                  <class name="body"/>
                  <class name="unity-lock-text"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="message">
                <property name="visible">false</property>
                <property name="wrap">true</property>
                <property name="justify">center</property>
                <property name="max-width-chars">36</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwPasswordEntryRow" id="password">
                    <property name="title" translatable="yes">Password</property>
                    <signal name="entry-activated" handler="on_password_activate" swapped="no"/>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="unlock_group">
                <child>
                  <object class="AdwButtonRow" id="unlock_button">
                    <property name="title" translatable="yes">Unlock</property>
                    <signal name="activated" handler="on_unlock_clicked" swapped="no"/>
                    <style>
                      <class name="suggested-action"/>
                      <class name="body"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
        </child>
      </object>
    </property>
  </template>
</interface>
